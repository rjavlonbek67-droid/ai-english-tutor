# Copy this file to .env for local server runs.
# Put the real key only in .env or in the host's environment settings.
# Never commit .env, paste the key into chat, or include it in a screenshot.
GROQ_API_KEY=
# Optional. Leave unset to try llama-3.3-70b-versatile, then other Groq models.
# GROQ_MODEL=llama-3.3-70b-versatile
PORT=3000
